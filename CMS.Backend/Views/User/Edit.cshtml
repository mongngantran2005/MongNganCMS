@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Sửa thành viên";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <h5 class="mb-0 fw-bold text-primary">Cập Nhật Thông Tin Thành Viên</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Tên đăng nhập (Read Only) -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-secondary">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input asp-for="Username" class="form-control bg-light" readonly />
                        </div>
                        <small class="text-muted"><i class="bi bi-info-circle"></i> Tên đăng nhập không thể thay đổi.</small>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                            <input type="password" name="newPassword" class="form-control" placeholder="Nhập nếu muốn thay đổi, để trống nếu giữ nguyên" />
                        </div>
                        <small class="text-muted">Để trống ô này nếu không muốn đổi mật khẩu của thành viên.</small>
                    </div>

                    <!-- Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-secondary">Họ và Tên</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-card-text"></i></span>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Quyền hạn -->
                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-semibold text-secondary">Vai trò / Quyền hạn</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-shield-lock"></i></span>
                            <select asp-for="Role" class="form-select" required>
                                <option value="Admin">Quản trị viên (Admin)</option>
                                <option value="Editor">Biên tập viên (Editor)</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="border-top pt-3 d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-semibold"><i class="bi bi-save"></i> Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
