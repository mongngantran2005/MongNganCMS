@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Thêm thành viên";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <h5 class="mb-0 fw-bold text-primary">Thêm Thành Viên Mới</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <!-- Tên đăng nhập -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-secondary">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Ví dụ: admin_a" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="PasswordHash" class="form-label fw-semibold text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Nhập mật khẩu truy cập..." required />
                        </div>
                        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                    </div>

                    <!-- Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-secondary">Họ và Tên</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-card-text"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Quyền hạn -->
                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-semibold text-secondary">Vai trò / Quyền hạn</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary"><i class="bi bi-shield-lock"></i></span>
                            <select asp-for="Role" class="form-select" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Admin">Quản trị viên (Admin)</option>
                                <option value="Editor">Biên tập viên (Editor)</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="border-top pt-3 d-flex gap-2 justify-content-end">
                        <button type="reset" class="btn btn-outline-secondary">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle"></i> Lưu thành viên</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
