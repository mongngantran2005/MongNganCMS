@{
    ViewData["Title"] = "Từ chối truy cập";
    Layout = "_LayoutAdmin";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center p-5 bg-white rounded-4 shadow-sm" style="max-width: 500px; border: 1px solid #f1f5f9;">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-shield-slash" style="font-size: 38px;"></i>
        </div>
        
        <h1 class="fw-bold text-danger fs-3 mb-3">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h1>
        
        <p class="text-secondary mb-4 leading-relaxed">
            Tài khoản hiện tại của bạn không có đủ quyền hạn để truy cập vào phân mục này. Vui lòng liên hệ quản trị viên để biết thêm chi tiết.
        </p>
        
        <div class="d-flex gap-3 justify-content-center">
            <a href="/" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                <i class="bi bi-house-door me-2"></i> Trang chủ
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4 py-2 rounded-3">
                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất tài khoản
            </a>
        </div>
    </div>
</div>
