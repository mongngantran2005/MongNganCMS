@{
    Layout = null; // Trang đăng nhập độc lập
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - MongNgan CMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #f8fafc;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .login-header {
            padding: 40px 30px 20px 30px;
            text-align: center;
        }

        .login-logo {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            margin-bottom: 20px;
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

        .login-title {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 5px;
            letter-spacing: -0.5px;
        }

        .login-subtitle {
            font-size: 14px;
            color: #94a3b8;
            font-weight: 400;
        }

        .login-body {
            padding: 20px 35px 40px 35px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            margin-bottom: 8px;
        }

        .input-group {
            position: relative;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            transition: all 0.2s ease;
        }

        .input-group:focus-within {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            background: rgba(15, 23, 42, 0.8);
        }

        .input-icon {
            padding: 12px 15px;
            color: #64748b;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-control-custom {
            flex: 1;
            background: transparent;
            border: none;
            padding: 12px 15px 12px 0;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #475569;
        }

        .btn-login {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border: none;
            color: white;
            padding: 12px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.3px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
            margin-top: 10px;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(59, 130, 246, 0.3);
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

        .btn-login:active {
            transform: translateY(1px);
        }

        .alert-custom {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-radius: 12px;
            font-size: 13px;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .hint-container {
            margin-top: 25px;
            padding: 12px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.06);
            font-size: 12px;
            color: #64748b;
        }

        .hint-title {
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-layers-half"></i>
                </div>
                <h1 class="login-title">MongNgan CMS</h1>
                <p class="login-subtitle">Hệ thống quản trị nội dung website</p>
            </div>
            <div class="login-body">
                <form asp-action="Login" method="post">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert-custom">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <div class="input-group">
                            <div class="input-icon">
                                <i class="bi bi-person"></i>
                            </div>
                            <input type="text" name="username" class="form-control-custom" placeholder="Nhập username..." required autocomplete="off" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Mật khẩu</label>
                        <div class="input-group">
                            <div class="input-icon">
                                <i class="bi bi-lock"></i>
                            </div>
                            <input type="password" name="password" class="form-control-custom" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-login w-100">ĐĂNG NHẬP HỆ THỐNG</button>
                </form>

                <div class="hint-container">
                    <div class="hint-title"><i class="bi bi-info-circle"></i> Tài khoản thử nghiệm:</div>
                    <div>Admin: <code>admin</code> / <code>admin123</code></div>
                    <div>Editor: <code>editor</code> / <code>editor123</code></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
