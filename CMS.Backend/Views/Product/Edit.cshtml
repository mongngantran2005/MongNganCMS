@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="text-warning mb-4">✏️ Chỉnh Sửa Sản Phẩm</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" /> <!-- Lưu lại url ảnh cũ -->

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CategoryProductId" class="form-label fw-bold">Danh mục</label>
            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductId">
                <option value="">-- Chọn danh mục --</option>
            </select>
            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-bold">Giá</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label fw-bold">Tồn kho</label>
            <input asp-for="StockQuantity" type="number" class="form-control" required />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ảnh hiện tại</label>
            <div>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Current Image" style="max-height: 100px;" class="mb-2" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </div>
            <label class="form-label fw-bold mt-2">Chọn ảnh mới (để trống nếu không đổi)</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
