@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Sửa Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var baseUrl = "http://localhost:5188";
    var currentImgSrc = string.IsNullOrEmpty(Model.ImageUrl) ? "" :
                        Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : baseUrl + Model.ImageUrl;
}

<div class="container-fluid mt-4 mb-5" style="max-width:800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <div style="width:5px;height:28px;background:#326e51;border-radius:4px;"></div>
            <h2 class="mb-0" style="color:#1a1a1a;font-weight:800;font-size:24px;">Sửa Banner</h2>
        </div>
        <a asp-action="Index" class="btn btn-sm d-flex align-items-center gap-1"
           style="background:#fff;border:1px solid #ddd;color:#555;border-radius:8px;padding:8px 16px;">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card border-0" style="border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.06);">
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius:8px;"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold">Tiêu đề Banner</label>
                    <input asp-for="Title" class="form-control" style="border-radius:8px;padding:10px 14px;" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- Current Image -->
                @if (!string.IsNullOrEmpty(currentImgSrc))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ảnh hiện tại</label>
                        <div>
                            <img id="currentImg" src="@currentImgSrc" alt="@Model.Title"
                                 style="max-width:100%;max-height:200px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label class="form-label fw-semibold">Thay ảnh mới (để trống nếu không đổi)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*"
                           onchange="previewNew(this)" style="border-radius:8px;padding:10px 14px;" />
                    <small class="text-muted">Khuyến nghị: 1200×360px. Định dạng: JPG, PNG, WebP</small>
                    <div id="newPreview" class="mt-2" style="display:none;">
                        <p class="text-muted small mb-1">Xem trước ảnh mới:</p>
                        <img id="newImg" src="#" alt="Preview"
                             style="max-width:100%;max-height:200px;object-fit:cover;border-radius:8px;border:2px dashed #326e51;" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="TargetUrl" class="form-label fw-semibold">Link đích (tuỳ chọn)</label>
                    <input asp-for="TargetUrl" class="form-control" placeholder="https://..."
                           style="border-radius:8px;padding:10px 14px;" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Thứ tự hiển thị</label>
                        <input asp-for="DisplayOrder" class="form-control" type="number"
                               style="border-radius:8px;padding:10px 14px;" />
                        <small class="text-muted">Số nhỏ hơn sẽ hiển thị trước</small>
                    </div>
                    <div class="col-md-6 mb-4 d-flex align-items-end">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" style="width:44px;height:24px;" />
                            <label class="form-check-label fw-semibold ms-2" asp-for="IsActive">
                                Kích hoạt (hiển thị trên trang chủ)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn text-white px-5 py-2"
                            style="background:#326e51;border-radius:8px;font-weight:600;box-shadow:0 4px 12px rgba(50,110,81,.25);">
                        <i class="fas fa-save me-1"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn px-4 py-2"
                       style="background:#f5f5f5;border-radius:8px;color:#555;font-weight:600;">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewNew(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('newImg').setAttribute('src', e.target.result);
                    document.getElementById('newPreview').style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
