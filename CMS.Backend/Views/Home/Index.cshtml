@model List<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-5">
    <!-- KHU VỰC SẢN PHẨM -->
    <h2 class="mb-4 text-primary fw-bold text-center">🛒 SẢN PHẨM NỔI BẬT</h2>

    @{ var latestProducts = ViewBag.LatestProducts as List<CMS.Data.Entities.Product>; }
    @if (latestProducts == null || !latestProducts.Any())
    {
        <div class="alert alert-info text-center mb-5">Chưa có sản phẩm nào.</div>
    }
    else
    {
        <div class="row mb-5">
            @foreach (var item in latestProducts)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 product-card" style="transition: transform 0.2s;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                                 style="height: 220px; object-fit: cover; border-top-left-radius: 8px; border-top-right-radius: 8px;" />
                        }
                        else
                        {
                            <div class="bg-light text-muted d-flex align-items-center justify-content-center"
                                 style="height: 220px; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                                <i class="bi bi-image" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2" style="width: fit-content; font-size: 0.75rem;">
                                @(item.CategoryProduct?.Name ?? "Chưa phân loại")
                            </span>
                            <h5 class="card-title text-dark fw-bold mb-1" style="font-size: 1.1rem;">@item.Name</h5>
                            <div class="mt-auto pt-3">
                                <p class="card-text text-danger fw-bold fs-5 mb-3">
                                    @item.Price.ToString("N0") đ
                                </p>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.Id" class="btn btn-outline-primary w-50 rounded-pill d-flex align-items-center justify-content-center">
                                        Chi tiết
                                    </a>
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="w-50">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary w-100 rounded-pill">
                                            <i class="bi bi-cart-plus"></i> Đặt
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <hr class="my-5" />

    <!-- KHU VỰC BÀI VIẾT -->
    <h2 class="mb-4 text-danger fw-bold text-center">📰 TIN TỨC MỚI NHẤT</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">Chưa có bài viết nào. Hãy thêm bài viết mới!</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span>Không có ảnh</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary mb-2" style="width: fit-content;">
                                @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                            <h5 class="card-title">@item.Title</h5>
                            <p class="card-text text-muted small">
                                @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>
                            <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm mt-auto">
                                Đọc tiếp →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-2">
            <a asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary">
                Xem tất cả bài viết
            </a>
        </div>
    }
</div>
