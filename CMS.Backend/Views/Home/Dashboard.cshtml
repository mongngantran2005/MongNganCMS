@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bảng điều khiển";
    
    var latestPosts = ViewBag.LatestPosts as List<CMS.Data.Entities.Post>;
    var latestUsers = ViewBag.LatestUsers as List<CMS.Data.Entities.User>;
}

<style>
    .dashboard-stat-card {
        background: white;
        border-radius: 12px;
        border: none;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .dashboard-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.08);
    }
    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        flex-shrink: 0;
    }
    .stat-number {
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.2;
    }
    .stat-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <!-- Posts -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-primary"><i class="bi bi-file-earmark-text"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalPosts</div>
                <div class="stat-label">Bài viết</div>
            </div>
        </div>
    </div>
    <!-- Users -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-danger"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalUsers</div>
                <div class="stat-label">Thành viên</div>
            </div>
        </div>
    </div>
    <!-- Categories -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-success"><i class="bi bi-grid-3x3-gap"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalCategories</div>
                <div class="stat-label">Danh mục</div>
            </div>
        </div>
    </div>
    <!-- Products -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-info text-white"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalProducts</div>
                <div class="stat-label">Sản phẩm</div>
            </div>
        </div>
    </div>
    <!-- Customers -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-warning text-dark"><i class="bi bi-person-badge"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalCustomers</div>
                <div class="stat-label">Khách hàng</div>
            </div>
        </div>
    </div>
    <!-- Orders -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="dashboard-stat-card">
            <div class="stat-icon bg-secondary"><i class="bi bi-cart3"></i></div>
            <div>
                <div class="stat-number">@ViewBag.TotalOrders</div>
                <div class="stat-label">Đơn hàng</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Latest Posts -->
    <div class="col-lg-8">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-text text-primary me-2"></i>Bài viết mới đăng gần đây</h6>
                <a asp-controller="Post" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 px-4">Tiêu đề</th>
                                <th class="border-0">Danh mục</th>
                                <th class="border-0">Ngày đăng</th>
                                <th class="border-0 text-end px-4">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (latestPosts != null && latestPosts.Any())
                            {
                                foreach (var post in latestPosts)
                                {
                                    <tr>
                                        <td class="px-4 fw-semibold text-dark">@post.Title</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                                @(post.Category?.Name ?? "Chưa phân loại")
                                            </span>
                                        </td>
                                        <td class="text-muted" style="font-size:13px;">
                                            @post.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-end px-4">
                                            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-light">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Chưa có bài viết nào</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest Users -->
    <div class="col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-people text-danger me-2"></i>Thành viên mới nhất</h6>
                <a asp-controller="User" asp-action="Index" class="btn btn-sm btn-outline-danger">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 px-4">Tên đăng nhập</th>
                                <th class="border-0">Họ tên</th>
                                <th class="border-0 text-end px-4">Quyền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (latestUsers != null && latestUsers.Any())
                            {
                                foreach (var user in latestUsers)
                                {
                                    <tr>
                                        <td class="px-4 fw-bold text-dark">@user.Username</td>
                                        <td style="font-size:13px;">@user.FullName</td>
                                        <td class="text-end px-4">
                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size:10px;">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info" style="font-size:10px;">Editor</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">Chưa có thành viên nào</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
