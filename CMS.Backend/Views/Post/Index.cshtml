@model List<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Quản lý Bài viết";
    var categories = ViewBag.Categories as List<CMS.Data.Entities.Category>;
    int? selectedCategoryId = ViewBag.FilterCategoryId as int?;
}

<style>
    .post-card { transition: transform 0.2s, box-shadow 0.2s; border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
    .post-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    .post-card-img { height: 180px; object-fit: cover; width: 100%; }
    .post-card-img-placeholder { height: 180px; background: linear-gradient(135deg, #e2e8f0, #cbd5e1); display: flex; align-items: center; justify-content: center; font-size: 40px; color: #94a3b8; }
    .filter-bar { background: white; border-radius: 12px; padding: 16px 20px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); margin-bottom: 24px; }
    .stats-strip { display: flex; gap: 16px; margin-bottom: 24px; }
    .stat-pill { background: white; border-radius: 10px; padding: 12px 20px; box-shadow: 0 1px 6px rgba(0,0,0,0.06); display: flex; align-items: center; gap: 10px; }
    .stat-pill i { font-size: 20px; }
    .stat-pill .val { font-size: 20px; font-weight: 700; color: #1e293b; }
    .stat-pill .lbl { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
</style>

<!-- Stats -->
<div class="stats-strip">
    <div class="stat-pill">
        <i class="bi bi-file-earmark-text text-primary"></i>
        <div>
            <div class="val">@Model.Count()</div>
            <div class="lbl">Tổng bài viết</div>
        </div>
    </div>
    <div class="stat-pill">
        <i class="bi bi-grid-3x3-gap text-success"></i>
        <div>
            <div class="val">@(categories?.Count ?? 0)</div>
            <div class="lbl">Danh mục</div>
        </div>
    </div>
</div>

<!-- Filter + Add button -->
<div class="filter-bar d-flex align-items-end gap-3 flex-wrap">
    <form asp-action="Index" method="get" class="d-flex gap-3 align-items-end flex-wrap flex-grow-1">
        <div>
            <label class="form-label fw-semibold mb-1" style="font-size:12px;color:#64748b;">LỌC THEO DANH MỤC</label>
            <select name="categoryId" class="form-select form-select-sm" style="min-width:200px;">
                <option value="">-- Tất cả danh mục --</option>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        if (selectedCategoryId == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-funnel"></i> Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-circle"></i> Bỏ lọc</a>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>
</div>

<!-- Post Cards Grid -->
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox" style="font-size:60px;color:#cbd5e1;"></i>
        <p class="mt-3 text-muted fs-5">Chưa có bài viết nào. Hãy tạo bài viết đầu tiên!</p>
        <a asp-action="Create" class="btn btn-primary mt-2"><i class="bi bi-plus-circle"></i> Thêm bài viết</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card post-card h-100">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="post-card-img" alt="@item.Title" />
                    }
                    else
                    {
                        <div class="post-card-img-placeholder">
                            <i class="bi bi-image"></i>
                        </div>
                    }
                    <div class="card-body d-flex flex-column p-3">
                        <div class="mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:11px;">
                                @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </div>
                        <h6 class="card-title fw-semibold mb-1" style="font-size:14px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            @item.Title
                        </h6>
                        <p class="card-text text-muted mt-auto mb-2" style="font-size:12px;">
                            <i class="bi bi-calendar3"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>
                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info flex-grow-1" style="font-size:12px;">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" style="font-size:12px;">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               style="font-size:12px;"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}